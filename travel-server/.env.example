# 游迹 · 环境变量模板
#
# 用法：复制为 .env 后填写真实值，再执行：
#   set -a; source .env; set +a
# 注意：.env 已被 .gitignore 忽略，绝不要提交真实凭据。
# 服务器上由 systemd 的 EnvironmentFile=/opt/youji/.env 注入。

# ---------- 数据库（两项都必填，无默认值）----------
# 缺失任一项后端会直接启动失败，避免静默使用 root 或弱口令
# 账号请使用最小权限的业务账号（不要用 root）
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
# 远程库才需要改；本地默认即可（默认值见 application.yml）
# DB_URL=jdbc:mysql://<host>:<port>/travel_db?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# ---------- 外部服务（可选，不配则对应功能提示"未配置"）----------
DEEPSEEK_API_KEY=
AMAP_API_KEY=

# ---------- 可选 ----------
# 生产环境关闭 SQL 日志（默认会打印到 stdout）
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
# 上传目录，默认 ../travel-app/uploads
# UPLOAD_DIR=
