# ========== 依赖 / 构建产物 ==========
node_modules/
target/
*.class
*.jar
*.war
*.tmp
*.bak
*.orig
*.rej

# ========== 日志与运行时数据 ==========
logs/
*.log
*.rdb
dump.rdb

# Redis 免安装包（第三方二进制，约 40MB，不入库）
travel-server/redis/

# ========== 数据库备份 ==========
*.sql.bak
*.sql.gz
*.dump

# ========== 密钥 / 凭据（绝不能入库）==========
# 真实配置放 .env 或服务器环境变量，仓库里只保留 .env.example 占位模板
.env
.env.*
!.env.example
application-local.yml
application-local.properties
*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
known_hosts

# 部署用的 SSH 私钥目录（本地部署工具，不随项目走）
.deploy/

# 个人工具配置（含本机绝对路径白名单）
.claude/

# 本机一键启停脚本：只在本机用，线上走 systemd
/启动游迹.bat
/启动游迹.vbs
/停止游迹.bat

# ========== 编辑器 / 操作系统 ==========
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ========== 其他本地缓存 ==========
.pnpm-store/

# 用户上传的照片（运行时产生，不入库）
travel-app/uploads/
