# ========== 依赖 / 构建产物 ==========
node_modules/
target/
*.class
*.jar
*.war

# ========== 日志与运行时数据 ==========
logs/
*.log
*.rdb
dump.rdb

# Redis 免安装包（第三方二进制，约 40MB，不入库）
travel-server/redis/

# ========== 数据库本地备份 ==========
*.sql.bak
*.dump

# ========== 密钥 / 本地配置 ==========
# 真实密钥放环境变量（DEEPSEEK_API_KEY / AMAP_API_KEY），不要写进仓库
.env
.env.*
!.env.example
application-local.yml

# 个人工具配置（Claude Code 的权限白名单里含本机绝对路径，不随项目走）
.claude/

# 部署用的 SSH 私钥（绝不能进仓库）
.deploy/

# 本机一键启停脚本：只在本机用，线上走 systemd
/启动游迹.bat
/启动游迹.vbs
/停止游迹.bat

# ========== 编辑器 / 操作系统 ==========
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# pnpm 本地缓存（测试工具留下的，不要入库）
.pnpm-store/
.deploy/

# 用户上传的照片（运行时产生，不入库）
travel-app/uploads/

